{
  "expo": {
    "name": "Pusena",
    "slug": "abacusai-mobile-apps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.abacusai.bloomapp.t1787256823",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abacusai.bloomapp.t1787256823",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "abacusai1787256823",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-sensors",
        {
          "motionPermission": "Pusena, günlük adım sayınızı göstermek için hareket verisine ihtiyaç duyar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pusena, eşleşmiş partnerinizle konum paylaşmak için konumunuza ihtiyaç duyar.",
          "locationAlwaysAndWhenInUsePermission": "Paylaşım açıkken konumunuz uygulama kapalıyken de yalnızca eşleşmiş partnerinize gider.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "scheme": "abacusai1787256823",
    "extra": {
      "productionApiUrl": "https://pusena-api.onrender.com",
      "eas": {
        "projectId": "7bc418e6-d281-4c29-b935-84447480d52e"
      }
    }
  }
}
